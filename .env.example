# ETSYPILOT AI — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# (Placeholders only — NEVER place real production secrets in this file)

# Server & Application Environment
PORT=3000
NODE_ENV=production
APP_URL=https://craftcases.studio

# Database (Managed PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/etsypilot_db?sslmode=require

# Cryptography & Security
TOKEN_ENCRYPTION_KEY=your_64_char_hex_aes_256_encryption_key_here
JWT_SECRET=your_jwt_signing_secret_here

# Etsy Open API v3 (OAuth 2.0 PKCE)
ETSY_CLIENT_ID=your_etsy_client_id_keystring
ETSY_CLIENT_SECRET=your_etsy_shared_secret
ETSY_REDIRECT_URI=https://etsypilot-ai.ai.studio/api/etsy/auth/callback
ETSY_REQUEST_INTERVAL_MS=110
ETSY_MAX_RETRIES=3

# Pinterest Business API v5 (OAuth 2.0)
PINTEREST_APP_ID=your_pinterest_app_id
PINTEREST_APP_SECRET=your_pinterest_app_secret
PINTEREST_REDIRECT_URI=https://craftcases.studio/api/pinterest/auth/callback

# Google Gemini API
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=models/gemini-2.5-flash
AI_ANALYSIS_DAILY_LIMIT=50

# Affiliate & Monetization Network (Optional direct API key; otherwise operates in CSV/JSON import mode)
ETSY_AFFILIATE_NETWORK_API_KEY=

# Publication Sandbox & Safety Gate
CONTROLLED_PUBLICATION_TEST=false
SYNC_INTERVAL_MINUTES=30
SCHEDULER_CHECK_INTERVAL_SECONDS=60
